# Postgres in docker-compose; leave unset to use a local SQLite file.
DATABASE_URL=postgresql+psycopg://dataforge:dataforge@localhost:5432/dataforge
# Redis for the arq job queue; leave unset to run jobs in-process.
REDIS_URL=redis://localhost:6379
# LLM planner. Without a key the heuristic planner is used.
ANTHROPIC_API_KEY=
# Optional source credentials.
GITHUB_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
HF_TOKEN=
# Optional: YouTube Data API key (yt-dlp search is used without it).
YOUTUBE_API_KEY=
# Optional: Semantic Scholar API key (unauthenticated calls are heavily rate-limited).
S2_API_KEY=
# Accounts and team projects (off = single-user).
AUTH_ENABLED=false
# OPEN_SIGNUP=true
# SECURE_COOKIES=false
